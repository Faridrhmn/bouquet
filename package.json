{
  "name": "dzakirah-bouquet-backend",
  "version": "1.0.0",
  "description": "Backend API Node.js & PostgreSQL untuk Dzakirah Bouquet",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:seed": "psql -d dzakirah_db -f schema.sql",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:status": "node scripts/migrate.js status",
    "db:migrate:create": "node scripts/migrate.js create"
  },
  "keywords": [
    "bouquet",
    "express",
    "postgresql",
    "nodejs"
  ],
  "author": "Dzakirah Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "sharp": "^0.33.4"
  }
}
